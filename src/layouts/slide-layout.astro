---
import '~/styles/slides.css';

import BaseHead from '~/components/base-head.astro';
import MonitoringScript from '~/components/monitoring-script.astro';
import ThemeHeadScript from '~/components/theme-head-script.astro';
import type { SlideMeta } from '~/libs/slides';
import { STORAGE_THEME_KEY } from '~/libs/stores/theme';
import { cn } from '~/libs/utils';

type Props = {
  meta: SlideMeta;
  class?: string;
};

const { meta, class: className } = Astro.props;

const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="ko">
  <head>
    <BaseHead lang="ko" title={meta.title} description={meta.description} />
    <ThemeHeadScript />
    <MonitoringScript />
  </head>
  <body>
    <main
      class={cn('deck', className)}
      tabindex="-1"
      data-theme-key={STORAGE_THEME_KEY}
      data-share-url={shareUrl}
    >
      <slot />
      <div class="deck-progress" aria-hidden="true"></div>
      <div class="deck-counter" aria-live="polite"></div>
      <div class="deck-menu" role="menu" tabindex="-1" popover="manual">
        <div class="deck-menu-status" aria-hidden="true"></div>
        <button type="button" role="menuitem" data-action="prev">
          <span>이전 슬라이드</span><kbd>←</kbd>
        </button>
        <button type="button" role="menuitem" data-action="next">
          <span>다음 슬라이드</span><kbd>→</kbd>
        </button>
        <button type="button" role="menuitem" data-action="first">
          <span>첫 슬라이드</span><kbd>Home</kbd>
        </button>
        <button type="button" role="menuitem" data-action="last">
          <span>마지막 슬라이드</span><kbd>End</kbd>
        </button>
        <button type="button" role="menuitem" data-action="overview">
          <span>장표 한눈에 보기</span><kbd>O</kbd>
        </button>
        <form class="deck-menu-goto">
          <input
            type="number"
            name="page"
            min="1"
            inputmode="numeric"
            aria-label="이동할 슬라이드 번호"
            required
          />
          <button type="submit">이동</button>
        </form>
        <hr />
        <button type="button" role="menuitem" data-action="copy-link">
          <span>현재 슬라이드 링크 복사</span>
        </button>
        <button type="button" role="menuitem" data-action="qr">
          <span>QR 코드 표시</span><kbd>Q</kbd>
        </button>
        <button type="button" role="menuitem" data-action="pdf">
          <span>PDF로 다운로드</span>
        </button>
        <hr />
        <button type="button" role="menuitem" data-action="fullscreen">
          <span data-label>전체화면</span><kbd>F</kbd>
        </button>
        <button type="button" role="menuitem" data-action="theme">
          <span>테마 전환</span><kbd>T</kbd>
        </button>
        {
          import.meta.env.DEV && (
            <button type="button" role="menuitem" data-action="edit">
              <span data-label>편집 모드</span>
              <kbd>E</kbd>
            </button>
          )
        }
        <hr />
        <a href="/slides" role="menuitem">홈으로</a>
      </div>
      <dialog class="deck-qr" aria-label="QR 코드">
        <button type="button" class="deck-close" aria-label="닫기">
          <!-- lucide x -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
        <div class="deck-qr-code"></div>
        <button type="button" class="deck-qr-url"></button>
        <small class="deck-qr-hint">클릭하여 URL 복사 · ESC 또는 Q로 닫기</small
        >
      </dialog>
      <dialog class="deck-overview" aria-label="장표 한눈에 보기">
        <button type="button" class="deck-close" aria-label="닫기">
          <!-- lucide x -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
        <ol class="deck-overview-grid"></ol>
      </dialog>
    </main>
  </body>
</html>

<script>
  import { renderSVG } from 'uqr';

  // themeStore는 giscus(React)를 import해 React island가 없는 이 페이지에서 dev 오류를 낸다.
  // 같은 localStorage 키를 직접 다뤄 블로그와 테마를 공유한다.
  const deck = document.querySelector<HTMLElement>('.deck')!;
  // 오버뷰 복제본과 섞이지 않도록 직계 자식만 장으로 센다.
  const slides = [...deck.querySelectorAll<HTMLElement>(':scope > .slide')];
  const progress = deck.querySelector<HTMLElement>('.deck-progress')!;
  const counter = deck.querySelector<HTMLElement>('.deck-counter')!;
  const menuStatus = deck.querySelector<HTMLElement>('.deck-menu-status')!;
  const prevItem = deck.querySelector<HTMLButtonElement>(
    '[data-action="prev"]',
  )!;
  const nextItem = deck.querySelector<HTMLButtonElement>(
    '[data-action="next"]',
  )!;

  let current = 0;

  const render = () => {
    const total = slides.length;
    progress.style.setProperty('--progress', `${(current + 1) / total}`);
    const status = `슬라이드 ${current + 1} / ${total}`;
    counter.textContent = `${current + 1}`;
    menuStatus.textContent = status;
    menuStatus.parentElement!.ariaLabel = status;
    prevItem.disabled = current === 0;
    nextItem.disabled = current === total - 1;
    slides.forEach((slide, i) =>
      slide.toggleAttribute('data-current', i === current),
    );
    history.replaceState(null, '', `#${current + 1}`);
  };

  const clamp = (value: number, min: number, max: number) =>
    Math.max(min, Math.min(max, value));

  const goTo = (index: number, behavior: ScrollBehavior = 'smooth') => {
    slides[clamp(index, 0, slides.length - 1)]?.scrollIntoView({ behavior });
  };

  // 한 장씩은 방향이 보이게 스크롤하고, 먼 이동은 중간 장을 훑지 않도록 즉시 이동한다.
  const goPrev = () => goTo(current - 1);
  const goNext = () => goTo(current + 1);
  const goFirst = () => goTo(0, 'instant');
  const goLast = () => goTo(slides.length - 1, 'instant');

  // 휠/터치 이동은 scroll-snap이 처리하고, 현재 위치만 추적한다.
  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries.find((entry) => entry.isIntersecting);
      if (!visible) return;
      current = slides.indexOf(visible.target as HTMLElement);
      render();
    },
    { root: deck, threshold: 0.6 },
  );
  slides.forEach((slide) => observer.observe(slide));

  const themeKey = deck.dataset.themeKey!;

  const applyTheme = (theme: string | null) => {
    const isDark = theme
      ? theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.classList.toggle('dark', isDark);
  };

  const toggleTheme = () => {
    const isDark = document.documentElement.classList.contains('dark');
    const next = isDark ? 'light' : 'dark';
    localStorage.setItem(themeKey, next);
    applyTheme(next);
  };

  // 다른 탭(블로그)에서 테마를 바꾸면 따라간다.
  window.addEventListener('storage', (e) => {
    if (e.key === themeKey) applyTheme(e.newValue);
  });

  const toggleFullscreen = () => {
    if (!document.fullscreenEnabled) return;
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else {
      document.documentElement.requestFullscreen();
    }
  };

  const menu = deck.querySelector<HTMLElement>('.deck-menu')!;
  const fullscreenItem = menu.querySelector<HTMLButtonElement>(
    '[data-action="fullscreen"]',
  )!;

  const qr = deck.querySelector<HTMLDialogElement>('.deck-qr')!;
  const qrCode = qr.querySelector<HTMLElement>('.deck-qr-code')!;
  const qrUrl = qr.querySelector<HTMLButtonElement>('.deck-qr-url')!;
  const COPY_FEEDBACK_MS = 1500;

  const getSlideUrl = () => `${deck.dataset.shareUrl}#${current + 1}`;

  // 성공 여부만 돌려주고 피드백 표시는 호출한 쪽이 정한다.
  const copyText = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch (error) {
      console.error('[slides] URL 복사 실패', error);
      return false;
    }
  };

  const openQr = () => {
    const url = getSlideUrl();
    // 다크 테마에서도 인식률을 위해 흰 바탕에 검은 모듈로 그린다.
    qrCode.innerHTML = renderSVG(url, { border: 2 });
    qrUrl.textContent = url;
    qrUrl.dataset.url = url;
    qr.showModal();
  };

  const toggleQr = () => (qr.open ? qr.close() : openQr());

  qr.querySelector('.deck-close')!.addEventListener('click', () => qr.close());
  qr.addEventListener('close', () => deck.focus());

  qrUrl.addEventListener('click', async () => {
    const url = qrUrl.dataset.url!;
    const isCopied = await copyText(url);
    qrUrl.textContent = isCopied ? '복사됨' : '복사 실패';
    setTimeout(() => (qrUrl.textContent = url), COPY_FEEDBACK_MS);
  });

  const overview = deck.querySelector<HTMLDialogElement>('.deck-overview')!;
  const overviewGrid = overview.querySelector<HTMLElement>(
    '.deck-overview-grid',
  )!;
  let overviewItems: HTMLButtonElement[] = [];

  // 복제본은 실제 뷰포트 크기(vw·dvh)로 그린 뒤 transform으로 줄인다.
  const updateOverviewScale = () => {
    const frame = overviewGrid.querySelector<HTMLElement>(
      '.deck-overview-frame',
    );
    if (!frame) return;
    overview.style.setProperty(
      '--overview-scale',
      `${frame.clientWidth / innerWidth}`,
    );
  };

  const buildOverview = () => {
    overviewItems = slides.map((slide, i) => {
      const clone = slide.cloneNode(true) as HTMLElement;
      clone.inert = true;
      clone.removeAttribute('data-current');
      [clone, ...clone.querySelectorAll('[id]')].forEach((el) =>
        el.removeAttribute('id'),
      );
      const frame = document.createElement('span');
      frame.className = 'deck-overview-frame';
      frame.append(clone);
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'deck-overview-item';
      item.ariaLabel = `슬라이드 ${i + 1}`;
      item.append(frame);
      item.addEventListener('click', () => {
        overview.close();
        goTo(i, 'instant');
      });
      return item;
    });
    overviewGrid.append(
      ...overviewItems.map((item) => {
        const li = document.createElement('li');
        li.append(item);
        return li;
      }),
    );
  };

  const openOverview = () => {
    if (!overviewItems.length) buildOverview();
    overviewItems.forEach((item, i) => {
      item.ariaCurrent = i === current ? 'true' : null;
    });
    overview.showModal();
    updateOverviewScale();
    const item = overviewItems[current];
    item.scrollIntoView({ block: 'center', behavior: 'instant' });
    item.focus({ preventScroll: true });
  };

  const toggleOverview = () =>
    overview.open ? overview.close() : openOverview();

  overview
    .querySelector('.deck-close')!
    .addEventListener('click', () => overview.close());
  overview.addEventListener('close', () => deck.focus());
  window.addEventListener('resize', () => {
    if (overview.open) updateOverviewScale();
  });

  const isOverlayOpen = () => qr.open || overview.open;

  const MENU_ACTIONS: Record<string, () => void> = {
    prev: goPrev,
    next: goNext,
    first: goFirst,
    last: goLast,
    overview: openOverview,
    'copy-link': () => copyText(getSlideUrl()),
    qr: openQr,
    pdf: () => window.print(),
    fullscreen: toggleFullscreen,
    theme: toggleTheme,
  };

  const gotoForm = menu.querySelector<HTMLFormElement>('.deck-menu-goto')!;
  const gotoInput = gotoForm.querySelector<HTMLInputElement>('input')!;
  gotoInput.max = `${slides.length}`;
  gotoInput.placeholder = `1-${slides.length}`;

  // submit 하나로 Enter와 이동 버튼을 함께 처리한다. 범위 검사는 min/max 속성이 맡는다.
  gotoForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const page = gotoInput.valueAsNumber;
    gotoForm.reset();
    menu.hidePopover();
    goTo(page - 1, 'instant');
  });

  fullscreenItem.hidden = !document.fullscreenEnabled;

  document.addEventListener('fullscreenchange', () => {
    fullscreenItem.querySelector('[data-label]')!.textContent =
      document.fullscreenElement ? '전체화면 종료' : '전체화면';
    deck.focus();
  });

  const isMenuOpen = () => menu.matches(':popover-open');

  const closeMenu = () => {
    if (isMenuOpen()) menu.hidePopover();
  };

  const MENU_EDGE_GAP = 8;

  // 화면 밖으로 넘치지 않도록 가장자리 여백 안에 둔다.
  const openMenuAt = (clientX: number, clientY: number) => {
    if (!isMenuOpen()) menu.showPopover();
    const maxX = innerWidth - menu.offsetWidth - MENU_EDGE_GAP;
    const maxY = innerHeight - menu.offsetHeight - MENU_EDGE_GAP;
    const x = clamp(clientX, MENU_EDGE_GAP, maxX);
    const y = clamp(clientY, MENU_EDGE_GAP, maxY);
    menu.style.translate = `${x}px ${y}px`;
    // 항목 대신 메뉴에 포커스를 둬서 다음 Tab에 첫 항목으로 가게 한다.
    menu.focus({ preventScroll: true });
  };

  // macOS는 mousedown에 contextmenu가 발생해 auto popover가 뒤따르는 mouseup에 닫힌다.
  // manual popover로 열고 닫기 조건을 직접 관리한다.
  deck.addEventListener('contextmenu', (e) => {
    if (isOverlayOpen()) return;
    e.preventDefault();
    openMenuAt(e.clientX, e.clientY);
  });

  // 모바일엔 우클릭이 없어 빠른 두 번 탭(클릭)으로도 메뉴를 연다.
  // 모바일 브라우저는 dblclick을 안정적으로 보내지 않아 click 간격으로 직접 판정한다.
  // pointerup에서 열면 뒤따르는 터치의 click이 방금 뜬 메뉴 항목을 눌러 버린다.
  const DOUBLE_TAP_MS = 300;
  const TAP_SLOP_PX = 24;
  let lastTap: { x: number; y: number; time: number } | undefined;

  // 글자 위 더블 클릭은 단어 선택으로 남긴다.
  // caret 위치만으론 여백 클릭도 가장 가까운 글자로 잡혀 글자 박스 안인지 다시 확인한다.
  const isOverText = (x: number, y: number) => {
    const caret = document.caretPositionFromPoint?.(x, y);
    const node =
      caret?.offsetNode ?? document.caretRangeFromPoint?.(x, y)?.startContainer;
    if (node?.nodeType !== Node.TEXT_NODE || !node.textContent?.trim())
      return false;
    const range = document.createRange();
    range.selectNodeContents(node);
    return Array.from(range.getClientRects()).some(
      (r) => x >= r.left && x <= r.right && y >= r.top && y <= r.bottom,
    );
  };

  deck.addEventListener('click', (e) => {
    const isOverlay =
      menu.contains(e.target as Node) ||
      qr.contains(e.target as Node) ||
      overview.contains(e.target as Node);
    const tap = { x: e.clientX, y: e.clientY, time: e.timeStamp };
    const isDoubleTap =
      !isOverlay &&
      lastTap &&
      tap.time - lastTap.time < DOUBLE_TAP_MS &&
      Math.hypot(tap.x - lastTap.x, tap.y - lastTap.y) < TAP_SLOP_PX;
    lastTap = isDoubleTap || isOverlay ? undefined : tap;
    if (!isDoubleTap || isOverText(tap.x, tap.y)) return;
    // 여백 더블 클릭이 근처 단어를 선택했으면 지운다.
    getSelection()?.removeAllRanges();
    openMenuAt(tap.x, tap.y);
  });

  document.addEventListener('pointerdown', (e) => {
    const isRightButton = e.button === 2;
    if (isRightButton || menu.contains(e.target as Node)) return;
    closeMenu();
  });
  deck.addEventListener('scroll', closeMenu, { passive: true });
  // 모바일에서 이동 입력칸에 포커스하면 키보드가 뷰포트를 줄여 resize가 발생한다.
  window.addEventListener('resize', () => {
    if (!menu.contains(document.activeElement)) closeMenu();
  });
  window.addEventListener('blur', closeMenu);

  menu.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest<HTMLElement>(
      '[data-action]',
    );
    if (!item) return;
    menu.hidePopover();
    MENU_ACTIONS[item.dataset.action!]?.();
  });

  menu.addEventListener('toggle', (e) => {
    // 메뉴 항목이 시작한 smooth 스크롤을 focus가 끊지 않도록 막는다.
    if ((e as ToggleEvent).newState === 'closed') {
      deck.focus({ preventScroll: true });
    }
  });

  const KEY_ACTIONS: Record<string, () => void> = {
    ArrowRight: goNext,
    ArrowDown: goNext,
    PageDown: goNext,
    ' ': goNext,
    ArrowLeft: goPrev,
    ArrowUp: goPrev,
    PageUp: goPrev,
    Home: goFirst,
    End: goLast,
  };

  // 문자 단축키는 물리 키로 판정한다. 한글 자판에서는 e.key가 'ㄹ', 'ㅅ'이나 'Process'로 들어온다.
  const CODE_ACTIONS: Record<string, () => void> = {
    KeyF: toggleFullscreen,
    KeyT: toggleTheme,
    KeyQ: toggleQr,
    KeyO: toggleOverview,
  };

  document.addEventListener('keydown', (e) => {
    // 편집 중인 글자 입력은 단축키로 가로채지 않는다.
    if ((e.target as HTMLElement).isContentEditable) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (isMenuOpen()) {
      if (e.key === 'Escape') closeMenu();
      return;
    }
    // Escape는 dialog 기본 동작이 닫는다.
    if (qr.open) {
      if (e.code === 'KeyQ') qr.close();
      return;
    }
    // 오버뷰 안의 Tab·Enter·화살표는 기본 동작(포커스 이동, 스크롤)에 맡긴다.
    if (overview.open) {
      if (e.code === 'KeyO') overview.close();
      return;
    }
    const action = KEY_ACTIONS[e.key] ?? CODE_ACTIONS[e.code];
    if (!action) return;
    e.preventDefault();
    action();
  });

  // 편집 모드는 dev 서버에서만 쓴다. 분기째 prod 번들에서 빠진다.
  if (import.meta.env.DEV) {
    import('~/libs/slide-editor').then(({ createSlideEditor }) => {
      const editor = createSlideEditor(deck, slides);
      MENU_ACTIONS.edit = editor.toggle;
      CODE_ACTIONS.KeyE = editor.toggle;
      KEY_ACTIONS.Escape = editor.exit;
    });
  }

  const initialIndex = Number(location.hash.slice(1)) - 1;
  if (initialIndex > 0) goTo(initialIndex, 'instant');
  deck.focus();
</script>
